        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6689" ANNOTATION_REF="a3709">
                <ANNOTATION_VALUE>(I) would go to my first aunts place.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6690" ANNOTATION_REF="a3710">
                <ANNOTATION_VALUE>(I) would go to stay there. I didn't want the Brawijaya regiment and I to meet.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6691" ANNOTATION_REF="a3711">
                <ANNOTATION_VALUE>Because I had heard (that) there was someone who had spoken about me (to the Brawijaya regiment).</ANNOTATION_VALUE>
