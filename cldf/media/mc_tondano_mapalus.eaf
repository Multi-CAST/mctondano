        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6697" ANNOTATION_REF="a3717">
                <ANNOTATION_VALUE>(About) where I supposedly am.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6698" ANNOTATION_REF="a3718">
                <ANNOTATION_VALUE>Sometimes my father would say (to him) "(she's) gone to Manado".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6699" ANNOTATION_REF="a3719">
                <ANNOTATION_VALUE>Sometimes he would say (to them) "She's gone out, (they) don't know where (she is).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6700" ANNOTATION_REF="a3720">
                <ANNOTATION_VALUE>Athough (they) knew (that) as for me, I was in Kendis.</ANNOTATION_VALUE>
