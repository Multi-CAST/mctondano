        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6644" ANNOTATION_REF="a3660">
                <ANNOTATION_VALUE>the Brawijaya regiment (of the TNI).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6645" ANNOTATION_REF="a3661">
                <ANNOTATION_VALUE>That is the Permesta rebellion.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
