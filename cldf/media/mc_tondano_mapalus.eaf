            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6641" ANNOTATION_REF="a3657">
                <ANNOTATION_VALUE>(We) would go to a party. (We) would go to dance at Kolet.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
