            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6693" ANNOTATION_REF="a3713">
                <ANNOTATION_VALUE>He would take me with a car, He would take (me) to Bitung.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6694" ANNOTATION_REF="a3714">
                <ANNOTATION_VALUE>And I hide!</ANNOTATION_VALUE>
