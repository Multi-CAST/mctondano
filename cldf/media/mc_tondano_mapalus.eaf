        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6638" ANNOTATION_REF="a3654">
                <ANNOTATION_VALUE>We would go to cultivate (crops).</ANNOTATION_VALUE>
