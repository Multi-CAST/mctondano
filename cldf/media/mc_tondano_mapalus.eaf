            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6660" ANNOTATION_REF="a3677">
                <ANNOTATION_VALUE>Although sometimes a fisherman would take me out. I didn't want (him) to take me out (either).</ANNOTATION_VALUE>
