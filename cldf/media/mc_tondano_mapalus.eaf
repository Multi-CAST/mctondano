                <ANNOTATION_VALUE>Yes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6647" ANNOTATION_REF="a3663">
                <ANNOTATION_VALUE>They went into the forest, all of our male friends (to escape the TNI).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6648" ANNOTATION_REF="a3664">
                <ANNOTATION_VALUE>(They) fled into the forest.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6649" ANNOTATION_REF="a3665">
                <ANNOTATION_VALUE>So we no longer know (that) (we) would do what'sit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6650" ANNOTATION_REF="a3666">
                <ANNOTATION_VALUE>(They) gave the night time hours (to us).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6651" ANNOTATION_REF="a3667">
                <ANNOTATION_VALUE>(We) could not go alone. After six o'clock (we) could no longer leave (from) the house. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6652" ANNOTATION_REF="a3668">
                <ANNOTATION_VALUE>(We) would go to the fields.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6653" ANNOTATION_REF="a3669">
                <ANNOTATION_VALUE>You have to have an identity card. If (you) don't have it, you can't (go out). </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6654" ANNOTATION_REF="a3670">
                <ANNOTATION_VALUE>They would hold you up (i.e. not let you leave). They would hold (you) up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6655" ANNOTATION_REF="a3671">
                <ANNOTATION_VALUE>All of the neighbourhood quaters had Brawijaya checkpoints.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6656" ANNOTATION_REF="a3672">
