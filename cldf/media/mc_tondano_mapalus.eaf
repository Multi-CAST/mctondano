        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6766" ANNOTATION_REF="a3787">
                <ANNOTATION_VALUE>The experience (of) the time when,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
