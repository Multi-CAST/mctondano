        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6696" ANNOTATION_REF="a3716">
                <ANNOTATION_VALUE>(He) is threatening my mother and my father.</ANNOTATION_VALUE>
