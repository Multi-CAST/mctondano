        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6688" ANNOTATION_REF="a3708">
                <ANNOTATION_VALUE>When it was already five o'clock I would go to Kendis.</ANNOTATION_VALUE>
