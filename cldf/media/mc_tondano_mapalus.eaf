        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6686" ANNOTATION_REF="a3706">
                <ANNOTATION_VALUE>In several weeks (I) went with my younger friend (to) the Taler people.</ANNOTATION_VALUE>
