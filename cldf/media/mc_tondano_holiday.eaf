            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7485" ANNOTATION_REF="a5294">
                <ANNOTATION_VALUE>would return home. We</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7486" ANNOTATION_REF="a5295">
                <ANNOTATION_VALUE>firstly came. (We) took a boat. We came to Kulala Lumpur, Malaysia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7487" ANNOTATION_REF="a5296">
                <ANNOTATION_VALUE>Again just there and we would again get a boat to Jakarta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7488" ANNOTATION_REF="a5297">
                <ANNOTATION_VALUE>Just there in Jakarta I would get again</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7489" ANNOTATION_REF="a5298">
                <ANNOTATION_VALUE>a boat. I would come to Manado, until Tondano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7490" ANNOTATION_REF="a5299">
                <ANNOTATION_VALUE>Yes, already (finished)</ANNOTATION_VALUE>
