            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15824" ANNOTATION_REF="a10112">
                <ANNOTATION_VALUE>rock, rock, slippery, slippery, (first in Indonesian and then in Tondano). So</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15825" ANNOTATION_REF="a10113">
                <ANNOTATION_VALUE>erh (the name) becomes</ANNOTATION_VALUE>
