        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15819" ANNOTATION_REF="a10107">
                <ANNOTATION_VALUE>Eh, that slippery rock,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
