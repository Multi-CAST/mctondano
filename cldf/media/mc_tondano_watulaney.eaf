        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15816" ANNOTATION_REF="a10104">
                <ANNOTATION_VALUE>Because there is in the village, erh its name is, erh,</ANNOTATION_VALUE>
